# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///instance/flixora.db

# Encryption key for API credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-me-generate-with-fernet

# Default Admin (used only for initial setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@flixora.com
ADMIN_PASSWORD=change-me-on-first-login

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=

# LLM Providers (configured via Settings UI, not here)
# OPENROUTER_API_KEY=
# GOOGLE_AI_API_KEY=

# Messaging (configured via Settings UI or Env)
# WHATSAPP_TOKEN=
# META_INSTAGRAM_TOKEN=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# GitHub Demo Deployment integration
GITHUB_TOKEN=
GITHUB_USERNAME=

# Production Mode Control
TEST_MODE=true

# Logging
LOG_LEVEL=INFO
